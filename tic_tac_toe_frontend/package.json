{
  "name": "tic-tac-toe-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js UI for a Tic-Tac-Toe game with Ocean Professional dark theme.",
  "scripts": {
    "dev": "cross-env PORT=${PORT:-3000} next dev -H 0.0.0.0 -p $PORT",
    "build": "next build",
    "start": "cross-env PORT=${PORT:-3000} next start -H 0.0.0.0 -p $PORT",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.11.28",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.9",
    "typescript": "5.4.5",
    "cross-env": "7.0.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
